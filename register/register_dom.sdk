aws route53domains get-domain-detail \
  --region us-east-1 \
  --domain-name $DOMAIN

aws route53domains check-domain-availability \
  --region us-east-1 \
  --domain-name $DOMAIN
        # EXPECT: UNAVAILABLE (someone owns it) or AVAILABLE (registration failed)
        {
            "Availability": "UNAVAILABLE"
        }

aws route53domains list-operations \
  --region us-east-1 \
  --submitted-since 2025-08-01T00:00:00Z \
  --query "Operations[?Type=='REGISTER_DOMAIN'].[SubmittedDate,Status,DomainName,OperationId]" \
  --output table
        -----------------------------------------------------------------------------------------
        |                                    ListOperations                                     |
        +----------------+--------------+-------------+-----------------------------------------+
        |  1755532652.953|  IN_PROGRESS |  $DOMAIN|  -891d-2b8cf4d17ff6                         |
        +----------------+--------------+-------------+-----------------------------------------+

aws route53domains get-operation-detail \
  --region us-east-1 \
  --operation-id 09016809-8745-42dd-891d-2b8cf4d17ff6
        {
            "OperationId": "--2b8cf4d17ff6",
